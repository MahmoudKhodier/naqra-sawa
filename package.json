{
  "name": "naqra-sawa",
  "version": "1.0.0",
  "private": true,
  "description": "نقرأ سوا (Read Together): reading circles for friends and family. Static PWA in site/, Android shell via Capacitor.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:sw": "node scripts/build-sw.js",
    "build:fonts": "node scripts/copy-fonts.js",
    "build:icons": "node scripts/render-icons.js",
    "build": "npm run build:sw",
    "serve": "npx --yes http-server@14.1.1 site -c-1 -p 8080",
    "cap:sync": "npm run build:sw && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/el-messiri": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0"
  }
}
